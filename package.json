{
  "name": "launch-discovery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Access page for Aether mission management",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "seed": "node --disable-warning=ExperimentalWarning tools/seed.js",
    "seed:slots": "node --disable-warning=ExperimentalWarning tools/seed-slots.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning tools/seed-demo.js",
    "demo:reset": "rm -f data/app.db data/app.db-wal data/app.db-shm && npm run seed && npm run seed:slots && npm run seed:supply && npm run seed:demo && npm run seed:alerts",
    "seed:alerts": "node --disable-warning=ExperimentalWarning tools/seed-alerts.js",
    "seed:supply": "node --disable-warning=ExperimentalWarning tools/seed-supply.js",
    "seed:logos": "node --disable-warning=ExperimentalWarning tools/seed-logos.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "express": "^5.1.0"
  }
}
